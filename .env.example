NODE_ENV=development

POSTGRES_USER=tailored_cv
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tailored_cv
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tailored_cv:change_me@localhost:5432/tailored_cv
DB_POOL_MAX=10
RUN_MIGRATIONS=true

# Criptografia de Senhas (Scrypt + Pepper) - gere uma string aleatória de 32 bytes / 64 hex chars
PEPPER=insira_aqui_um_pepper_secreto_de_alta_entropia_ex_openssl_rand_hex_32

# Usuário Inicial para primeiro acesso na plataforma
INITIAL_USER_EMAIL=seu_email@dominio.com
INITIAL_USER_PASSWORD=sua_senha
INITIAL_USER_NAME=Seu Nome
INITIAL_USER_USERNAME=seu_username

# AI Providers (Google Gemini)
GEMINI_API_KEY=
